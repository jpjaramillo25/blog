/* 2 = correcta, 1 = parcial, 0 = incorrecta */
function juzgar(sel, regla) {
  if (!sel || !sel.length) return 0;
  if (regla.any) {
    var dentro = sel.every(function (v) { return regla.any.indexOf(v) >= 0; });
    return dentro ? 2 : (sel.some(function (v) { return regla.any.indexOf(v) >= 0; }) ? 1 : 0);
  }
  var permitido = regla.req.concat(regla.opt || []);
  var todos = regla.req.every(function (v) { return sel.indexOf(v) >= 0; });
  var sinExtra = sel.every(function (v) { return permitido.indexOf(v) >= 0; });
