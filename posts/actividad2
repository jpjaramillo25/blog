function calificar2(clas, orden) {
  var res = {}, aciertos = 0;
  PIEZAS.forEach(function (p) { res[p.id] = clas[p.id] === p.cat; if (res[p.id]) aciertos++; });
  var idx = (orden || []).filter(function (id, k, arr) { return ORDEN.indexOf(id) >= 0 && arr.indexOf(id) === k; })
    .map(function (id) { return ORDEN.indexOf(id); });
  var mejor = 0, lis = [];
  for (var i = 0; i < idx.length; i++) {
    lis[i] = 1;
    for (var j = 0; j < i; j++) if (idx[j] < idx[i] && lis[j] + 1 > lis[i]) lis[i] = lis[j] + 1;
    if (lis[i] > mejor) mejor = lis[i];
  }
  var sobran = (orden || []).filter(function (id) { return ORDEN.indexOf(id) < 0; }).length;
  return { res: res, aciertos: aciertos, enOrden: mejor, total: ORDEN.length,
    exacto: mejor === ORDEN.length && idx.length === ORDEN.length && sobran === 0 };
