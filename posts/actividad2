var enviado1 = false;
function enviar1() {
  if (!listos('estado1')) return;
  var resp = [], falta = -1;
  FICHAS.forEach(function (f, i) { var a = marcados('a', i), s = marcados('s', i); if ((!a.length || !s.length) && falta < 0) falta = i; resp.push({ a: a, s: s }); });
  if (falta >= 0) { estado('estado1', 'Falta responder la ficha ' + (falta + 1) + ': marquen al menos una opción en cada pregunta.'); return; }
  var cal = calificar1(resp);
  var texto = 'Actividad 1: ¿dónde va esta fuente?\nIntegrantes: ' + nombres() + '\nFichas correctas: ' + cal.aciertos + ' de 6\n';
  FICHAS.forEach(function (f, i) {
    $('fb' + i).innerHTML = '<div class="fb ' + cal.res[i] + '"><b class="t">' + ROTULO[cal.res[i]] + '.</b> ' + esc(f.fb) + '</div>';
    texto += '\nFicha ' + (i + 1) + '. ' + f.t + '\nSu respuesta: aporta ' + resp[i].a.map(function (v) { return etiqueta(v, APORTA); }).join(', ') +
      '; va en ' + resp[i].s.map(function (v) { return etiqueta(v, SECCION); }).join(', ') + '.\n' + ROTULO[cal.res[i]] + '. ' + f.fb + '\n';
  });
  ofrecerCopia('copia1', texto);
  var resumen = 'Fichas correctas: ' + cal.aciertos + ' de 6. Lean la retroalimentación de cada ficha.';
  if (!HAY_GOOGLE) { estado('estado1', resumen); return; }
  if (enviado1) { estado('estado1', resumen + ' Su primer envío ya quedó registrado y enviado por correo.'); return; }
  enviado1 = true; estado('estado1', resumen + ' Guardando y enviando el correo…');
  google.script.run.withSuccessHandler(function (r) { estado('estado1', resumen + mensajeCorreo(r)); })
    .withFailureHandler(function (e) { enviado1 = false; estado('estado1', resumen + ' No se pudo guardar (' + e.message + '). Vuelvan a enviar.'); })
    .guardarActividad1({ integrantes: nombres(), correos: correosValidos().join(','), respuestas: resp });
}

/* ---------------- Actividad 2 ---------------- */
var orden = [];   /* ids de las piezas incluidas, en el orden que arma el par */
var clas = {};
function pintarAct2() {
  $('preg2').textContent = PREGUNTA2;
  $('piezas').innerHTML = PIEZAS.map(function (p, i) {
    return '<div class="card"><div class="fila"><span class="num">' + (i + 1) + '</span><span>' + esc(p.t) + '</span></div><div class="chips" role="group">' +
      CATS.map(function (c) { return '<label><input type="radio" name="cat' + p.id + '" value="' + c[0] + '" onchange="clasificar(\'' + p.id + '\', this)">' + c[1] + '</label>'; }).join('') +
      '</div><div id="fp' + p.id + '"></div></div>';
  }).join('');
  pintarOrden();
}
function clasificar(id, el) {
  Array.prototype.forEach.call(document.getElementsByName(el.name), function (r) { r.parentNode.classList.toggle('sel', r.checked); });
  clas[id] = el.value;
  var k = orden.indexOf(id);
  if (el.value === 'fuera') { if (k >= 0) orden.splice(k, 1); } else if (k < 0) orden.push(id);
  pintarOrden();
}
function mover(k, d) { var j = k + d; if (j < 0 || j >= orden.length) return; var t = orden[k]; orden[k] = orden[j]; orden[j] = t; pintarOrden(); var b = document.querySelector('#orden .item[data-id="' + t + '"] button[data-d="' + d + '"]'); if (b && !b.disabled) b.focus(); }
function pintarOrden() {
  $('orden').innerHTML = orden.length ? orden.map(function (id, k) {
    return '<div class="item" data-id="' + id + '"><div class="mov"><button type="button" data-d="-1" aria-label="Subir" onclick="mover(' + k + ',-1)"' + (k === 0 ? ' disabled' : '') + '>↑</button>' +
      '<button type="button" data-d="1" aria-label="Bajar" onclick="mover(' + k + ',1)"' + (k === orden.length - 1 ? ' disabled' : '') + '>↓</button></div><span>' + esc(pieza(id).t) + '</span></div>';
  }).join('') : '<div class="aviso mini">Todavía no hay piezas: clasifíquenlas en el paso 1.</div>';
}
var enviado2 = false;
function enviar2() {
  if (!listos('estado2')) return;
  var falta = -1; PIEZAS.forEach(function (p, i) { if (!clas[p.id] && falta < 0) falta = i; });
  if (falta >= 0) { estado('estado2', 'Falta clasificar la pieza ' + (falta + 1) + ' en el paso 1.'); return; }
  var pos1 = $('pos1').value.trim(), pos2 = $('pos2').value.trim();
  if (!pos1 || !pos2) { estado('estado2', 'Pónganle nombre a las dos posiciones en el paso 3.'); $(pos1 ? 'pos2' : 'pos1').focus(); return; }
  var cal = calificar2(clas, orden);
  var texto = 'Actividad 2: armar el argumento\nIntegrantes: ' + nombres() + '\nPiezas bien clasificadas: ' + cal.aciertos + ' de 10\nPiezas en el orden esperado: ' + cal.enOrden + ' de 8\n' +
    'Nombres de las posiciones: «' + pos1 + '» y «' + pos2 + '»\n';
  PIEZAS.forEach(function (p) {
    var ok = cal.res[p.id];
    $('fp' + p.id).innerHTML = '<div class="fb ' + (ok ? 'correcta' : 'incorrecta') + '"><b class="t">' + (ok ? 'Correcta' : 'Revisar: ' + etiqueta(p.cat, CATS)) + '.</b> ' + esc(p.fb) + '</div>';
    texto += '\n' + p.t + '\nSu respuesta: ' + etiqueta(clas[p.id], CATS) + '. ' + (ok ? 'Correcta' : 'Revisar: ' + etiqueta(p.cat, CATS)) + '. ' + p.fb + '\n';
  });
  texto += '\nEl párrafo-argumento armado:\n' + parrafoModelo() + '\n';
  $('modelo').innerHTML = '<b>' + (cal.exacto ? 'Su orden coincide con el párrafo armado.' : 'Así queda el párrafo armado; compárenlo con su orden.') + '</b>' +
    '<p class="modelo">' + esc(parrafoModelo()) + '</p><p class="mini">Cuatro movimientos: acuerdo, posición 1, posición 2 y vacío con el aporte. Quedaron fuera un dato del caso y una tesis propia de los autores.</p>';
  $('modelo').classList.remove('oculto');
  ofrecerCopia('copia2', texto);
  var resumen = 'Piezas bien clasificadas: ' + cal.aciertos + ' de 10. Piezas en el orden esperado: ' + cal.enOrden + ' de 8.';
  if (!HAY_GOOGLE) { estado('estado2', resumen); return; }
  if (enviado2) { estado('estado2', resumen + ' Su primer envío ya quedó registrado y enviado por correo.'); return; }
  enviado2 = true; estado('estado2', resumen + ' Guardando y enviando el correo…');
  google.script.run.withSuccessHandler(function (r) { estado('estado2', resumen + mensajeCorreo(r)); })
    .withFailureHandler(function (e) { enviado2 = false; estado('estado2', resumen + ' No se pudo guardar (' + e.message + '). Vuelvan a enviar.'); })
    .guardarActividad2({ integrantes: nombres(), correos: correosValidos().join(','), clas: clas, orden: orden, pos1: pos1, pos2: pos2 });
}
function verTab(n) {
  $('act1').classList.toggle('oculto', n !== 1); $('act2').classList.toggle('oculto', n !== 2);
  $('tab1').classList.toggle('on', n === 1); $('tab2').classList.toggle('on', n === 2);
  window.scrollTo(0, 0);
}

/* ---------------- Vista del docente ---------------- */
function filaBarra(rotulo, c, n) { var pct = n ? Math.round(100 * c / n) : 0;
  return '<tr><td>' + esc(rotulo) + '</td><td>' + c + ' de ' + n + ' (' + pct + ' %)</td><td style="width:35%"><div class="barra" style="width:' + pct + '%"></div></td></tr>'; }
function pintarDocente(r) {
  $('linkHoja').href = r.url || '#';
  $('docA1').innerHTML = r.n1 ? '<p class="mini">' + r.n1 + ' envíos</p><table><tr><th>Ficha</th><th>Correctas</th><th></th></tr>' +
    FICHAS.map(function (f, i) { return filaBarra((i + 1) + '. ' + f.t, r.porFicha[i] || 0, r.n1); }).join('') + '</table>' : '<p class="mini">Aún no hay envíos.</p>';
  $('docA2').innerHTML = r.n2 ? '<p class="mini">' + r.n2 + ' envíos · piezas en orden, promedio: ' + r.ordenMedio + ' de 8</p><table><tr><th>Pieza (categoría correcta)</th><th>Correctas</th><th></th></tr>' +
    PIEZAS.map(function (p, i) { return filaBarra((i + 1) + '. ' + p.t + ' (' + etiqueta(p.cat, CATS) + ')', r.porPieza[p.id] || 0, r.n2); }).join('') + '</table>' : '<p class="mini">Aún no hay envíos.</p>';
  $('docA3').innerHTML = (r.nombres || []).length ? '<table><tr><th>Par</th><th>Posición 1</th><th>Posición 2</th></tr>' +
    r.nombres.map(function (x) { return '<tr><td>' + esc(x.quien) + '</td><td>' + esc(x.pos1) + '</td><td>' + esc(x.pos2) + '</td></tr>'; }).join('') + '</table>' : '<p class="mini">Aún no hay envíos.</p>';
}
function cargarDocente() {
  if (!HAY_GOOGLE) return;
  estado('docEstado', 'Cargando…');
  google.script.run.withSuccessHandler(function (r) { $('docEstado').classList.add('oculto'); pintarDocente(r); })
    .withFailureHandler(function (e) { estado('docEstado', 'No se pudo cargar: ' + e.message); })
    .resumenDocente(CLAVE);
}

if (ES_DOCENTE) { $('estudiante').classList.add('oculto'); $('docente').classList.remove('oculto'); cargarDocente(); }
else { if (HAY_GOOGLE) $('bloqueCorreos').classList.remove('oculto'); pintarAct2(); }
</script>
